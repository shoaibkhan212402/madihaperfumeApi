<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Allow Cross-Origin Requests
  # Note: Express CORS middleware is already handling this, 
  # but Apache can also be configured here if needed.
</IfModule>
